  function quizIsCorrect(userAnswer, question) {
    const norm = quizNormalize(userAnswer);
    if (!norm) return false;
    return question.accept.some(a => {
      const na = quizNormalize(a);
      return norm === na || norm.includes(na) || na.includes(norm);
    });
  }

