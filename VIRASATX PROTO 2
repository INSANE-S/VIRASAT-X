    const capRight = document.createElement("div");
    capRight.className = "die-cap right";
    el.appendChild(capLeft);
    el.appendChild(capRight);

    const dieState = { el, currentX: 0 };
    el.style.transform = `${COSMETIC_TILT} rotateX(0deg)`;
    return dieState;
  }

  function rollDie(dieState) {
    return new Promise(resolve => {
      playDiceSound();
      const k = Math.floor(Math.random() * 4);
      const neededMod = (360 - faceAngles[k]) % 360;
      const baseFull = Math.floor(dieState.currentX / 360) * 360;
      const targetX = baseFull + 1080 + neededMod;

      dieState.el.style.transform = `${COSMETIC_TILT} rotateX(${targetX}deg)`;
      dieState.currentX = targetX;

      setTimeout(() => resolve(k + 1), 1200);
    });
  }

