  function bhagyaBuildReels() {
    const wrap = document.getElementById("bhagyaReelsWrap");
    wrap.innerHTML = "";
    bhagyaReels.length = 0;
    for (let i = 0; i < 3; i++) {
      const reel = document.createElement("div");
