      const strip = document.createElement("div");
      strip.className = "bhagya-reel-strip";
      reel.appendChild(strip);
      wrap.appendChild(reel);
      bhagyaReels.push({ reel, strip });
    }
    bhagyaResetReels();
  }

  function bhagyaFillStrip(strip, finalSymbol, strLen) {
    strip.innerHTML = "";
    strip.style.transition = "none";
    strip.style.transform = "translateY(0px)";
    const names = [];
    for (let i = 0; i < strLen - 1; i++) names.push(bhagyaRandomSymbol());
    names.push(finalSymbol);
    names.forEach(name => {
      const cell = document.createElement("div");
      cell.className = "bhagya-symbol";
      cell.textContent = BHAGYA_SYMBOL_EMOJI[name];
      strip.appendChild(cell);
    });
    return names;
  }

  function bhagyaResetReels() {
    bhagyaReels.forEach(({ strip }) => {
      bhagyaFillStrip(strip, bhagyaRandomSymbol(), 3);
    });
  }

  function bhagyaSpinReel(strip, targetSymbol, delayMs, durationMs) {
    return new Promise(resolve => {
      const strLen = 22 + Math.floor(Math.random() * 6);
      bhagyaFillStrip(strip, targetSymbol, strLen);
      const maxScroll = (strLen - 1) * BHAGYA_SYMBOL_H;
      strip.offsetHeight;
      setTimeout(() => {
        strip.style.transition = `transform ${durationMs}ms cubic-bezier(0.15, 0.85, 0.25, 1)`;
        strip.style.transform = `translateY(-${maxScroll}px)`;
        setTimeout(resolve, durationMs);
      }, delayMs);
    });
  }

