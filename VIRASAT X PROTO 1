<script>
  let audioCtx = null;

  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
  }

  function playDiceRollSound() {
    initAudio();
    if (!audioCtx) return;

    const rollsCount = 9;
    for (let i = 0; i < rollsCount; i++) {
      const delay = i * 0.11 + Math.random() * 0.03;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = i % 2 === 0 ? 'triangle' : 'sine';
      osc.frequency.setValueAtTime(140 + Math.random() * 120, audioCtx.currentTime + delay);
      osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + delay + 0.08);

      gain.gain.setValueAtTime(0.35, audioCtx.currentTime + delay);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + delay + 0.08);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(audioCtx.currentTime + delay);
      osc.stop(audioCtx.currentTime + delay + 0.08);
    }
  }

