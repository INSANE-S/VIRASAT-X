        document.getElementById("bhagyaOverlay").classList.remove("open");
        nextTurn();
      } else {
        logMsg(`🎰 <b>${player.name}</b> pulled the Bhagya lever and lost <b>₹${Math.abs(event.effect)}</b> — ${event.title}.`);
        document.getElementById("bhagyaOverlay").classList.remove("open");
        payRupees(player, null, Math.abs(event.effect), event.title);
        nextTurn();
      }
    };
  }

  function playerOwnsSet(playerId, group) {
    const groupTiles = BOARD_TILES.map((t, idx) => ({ ...t, idx })).filter(t => t.group === group);
    return groupTiles.every(t => gameState.boardState[t.idx].owner === playerId);
  }

  function openBuildMenu() {
    const player = gameState.players[gameState.currentPlayer];
    if (gameState.isRolling) return;

    const buildable = [];
    BOARD_TILES.forEach((tile, idx) => {
      if (tile.type === "property" && gameState.boardState[idx].owner === player.id) {
        if (playerOwnsSet(player.id, tile.group)) {
          buildable.push({ ...tile, idx });
        }
      }
    });

    if (buildable.length === 0) {
      showModal("BUILDING DECREE", "#C85A32", "No Realm Owned", "Requirement", "You must conquer all territories in a realm set before constructing Haveli or Royal Palaces!", [
        { label: "Close", callback: () => {} }
      ]);
      return;
    }

    const container = document.createElement("div");
    container.className = "build-list";

    buildable.forEach(tile => {
      const bState = gameState.boardState[tile.idx];
      const item = document.createElement("div");
      item.className = "build-item";
      
      const housesCount = bState.houses;
      const statusText = housesCount === 5 ? "Royal Palace" : `${housesCount} Haveli`;
      
      item.innerHTML = `
        <div style="text-align:left;">
          <strong style="color:${tile.color}; font-size:13px;">${tile.city} - ${tile.monument}</strong><br>
          <small>Cost: 🪙 ${tile.housePaisePrice}p | Status: ${statusText}</small>
        </div>
      `;

      const btn = document.createElement("button");
      btn.className = "action-btn build-btn";
      btn.style.padding = "5px 12px";
      btn.style.fontSize = "11px";
      btn.textContent = housesCount === 4 ? "+ Palace" : "+ Haveli";
      btn.disabled = housesCount >= 5 || player.paise < tile.housePaisePrice;

      btn.onclick = () => {
        modalOverlay.classList.remove("open");
        buildHouse(player, tile.idx);
      };

      item.appendChild(btn);
      container.appendChild(item);
    });

    showModal("CONSTRUCTION", "#C85A32", "Haveli & Palace Master", "Select a territory to build", container, [
      { label: "Close", callback: () => {} }
    ]);
  }

  document.getElementById("openBuildMenuBtn").addEventListener("click", openBuildMenu);

  async function movePlayerSteps(player, steps) {
    for(let i = 0; i < steps; i++) {
      const nextPos = (player.pos + 1) % BOARD_TILES.length;
      
      if(nextPos === 0) {
        player.rupees += 350;
        player.paise += 150;
        logMsg(`🏛️ <b>${player.name}</b> completed kingdom tour! Earned <b>₹350</b> & <b>150 Paise</b>.`);
        showTransactionPopup(player, "₹350 & 150p", true, "Completed Kingdom Tour");
        updateHUD();
      }

      player.pos = nextPos;
      updateTokenPositions();
      checkAndFlipBoardSide();
      await new Promise(r => setTimeout(r, 220));
    }
  }

  async function handleTurn() {
    if(gameState.isRolling) return;
    gameState.isRolling = true;
    rollBtn.disabled = true;

    playDiceRollSound();

    const player = gameState.players[gameState.currentPlayer];

    if(player.bankrupt) {
      nextTurn();
      return;
    }

    if(player.inJail) {
      player.jailTurns++;
      logMsg(`⛓️ <b>${player.name}</b> is confined in Bandigriha (Turn ${player.jailTurns}).`);
      if(player.jailTurns >= 2) {
        player.inJail = false;
        player.jailTurns = 0;
        logMsg(`🔓 <b>${player.name}</b> paid ₹100 fine and was released from Bandigriha!`);
        payRupees(player, null, 100, "Jail Release Fine");
      } else {
        setTimeout(nextTurn, 1000);
        return;
      }
    }

    const [d1, d2] = await Promise.all([rollDie(dieState1), rollDie(dieState2)]);
    const rollTotal = d1 + d2;
    logMsg(`🎲 <b>${player.name}</b> rolled Pasa total <b>${rollTotal}</b> (${d1}+${d2}).`);

    await movePlayerSteps(player, rollTotal);

    const cellIdx = player.pos;
    const tile = BOARD_TILES[cellIdx];
    const bState = gameState.boardState[cellIdx];

    if(tile.type === "property" || tile.type === "railroad") {
      const tileTitle = `${tile.city} - ${tile.monument}`;
      if(bState.owner === null) {
        if(player.rupees >= tile.price) {
          let deedHtml = '';

          if(tile.type === "property") {
            deedHtml = `
              <div class="deed-card">
                <img src="${tile.image}" style="width:100%; height:110px; object-fit:cover; border-radius:6px; margin-bottom:8px; border:1px solid #1C0A04;" onerror="this.onerror=null;this.src='${FALLBACK_IMG}';" />
                <div class="deed-row"><span class="deed-label">Land Claim Price:</span><span class="deed-val deed-highlight">₹${tile.price}</span></div>
                <div class="deed-row"><span class="deed-label">Base Tax:</span><span class="deed-val">₹${tile.rent[0]}</span></div>
                <div class="deed-row"><span class="deed-label">With 1 Haveli:</span><span class="deed-val">₹${tile.rent[1]}</span></div>
                <div class="deed-row"><span class="deed-label">With Royal Palace:</span><span class="deed-val deed-highlight">₹${tile.rent[5]}</span></div>
                <div class="deed-row" style="margin-top:4px;"><span class="deed-label">Haveli Build Cost:</span><span class="deed-val">🪙 ${tile.housePaisePrice} Paise</span></div>
              </div>
            `;
          } else {
            deedHtml = `
              <div class="deed-card">
                <img src="${tile.image}" style="width:100%; height:110px; object-fit:cover; border-radius:6px; margin-bottom:8px; border:1px solid #1C0A04;" onerror="this.onerror=null;this.src='${FALLBACK_IMG}';" />
                <div class="deed-row"><span class="deed-label">Airport Claim Price:</span><span class="deed-val deed-highlight">₹${tile.price}</span></div>
                <div class="deed-row"><span class="deed-label">Fixed Traveler Tax:</span><span class="deed-val">₹${tile.rent}</span></div>
              </div>
            `;
          }

          showModal(
            "TERRITORY FOR CLAIM",
            tile.color || "#1A365D",
            tileTitle,
            "Royal Title Deed & Revenue Sheet",
            deedHtml,
            [
              { label: `Claim Territory (₹${tile.price})`, callback: () => buyProperty(player, cellIdx) },
              { label: "Decline", callback: () => nextTurn() }
            ]
          );
        } else {
          logMsg(`❌ <b>${player.name}</b> lacks Rupees to claim <b>${tileTitle}</b>.`);
          nextTurn();
        }
      } else if(bState.owner !== player.id) {
        const owner = gameState.players[bState.owner];
        let rentAmount = 0;

        if(tile.type === "property") {
          rentAmount = tile.rent[bState.houses];
          if (bState.houses === 0 && playerOwnsSet(owner.id, tile.group)) {
            rentAmount *= 2;
          }
        } else {
          rentAmount = tile.rent;
        }

        logMsg(`💰 <b>${player.name}</b> entered ${tileTitle} owned by ${owner.name}. Paid <b>₹${rentAmount}</b> tax.`);
        payRupees(player, owner, rentAmount, `Land Rent for ${tile.city}`);
        nextTurn();
      } else {
        if(tile.type === "property" && playerOwnsSet(player.id, tile.group) && bState.houses < 5 && player.paise >= tile.housePaisePrice) {
          const isHotel = bState.houses === 4;
          const currentRent = tile.rent[bState.houses];
          const nextRent = tile.rent[bState.houses + 1];

          showModal(
            "UPGRADE TERRAIN",
            tile.color,
            tileTitle,
            "Construction Upgrade",
            `Construct a <b>${isHotel ? 'Royal Palace' : 'Haveli'}</b> for <b>🪙 ${tile.housePaisePrice} Paise</b>?<br><br>
             Revenue Increase: <b>₹${currentRent}</b> ➔ <b style="color:#C85A32;">₹${nextRent}</b>`,
            [
              { label: `Construct (${tile.housePaisePrice}p)`, callback: () => buildHouse(player, cellIdx) },
              { label: "Skip", callback: () => nextTurn() }
            ]
          );
        } else {
          nextTurn();
        }
      }
    } else if(tile.type === "chance") {
      openChanceQuizModal(player);
    } else if(tile.type === "community") {
      openWheelModal(player, tile.title);
    } else if(tile.type === "corner" && tile.title === "GO TO JAIL") {
      logMsg(`🚨 <b>${player.name}</b> was captured! Sent directly to Bandigriha.`);
      player.pos = 8;
      player.inJail = true;
      updateTokenPositions();
      checkAndFlipBoardSide();
      nextTurn();
    } else {
      nextTurn();
    }
  }

  function buyProperty(player, cellIdx) {
    const tile = BOARD_TILES[cellIdx];
    const tileTitle = `${tile.city} - ${tile.monument}`;
    player.rupees -= tile.price;
    gameState.boardState[cellIdx].owner = player.id;
    
    const cellEl = document.getElementById(`cell-${cellIdx}`);
    if(cellEl) cellEl.classList.add("owned");

    const indicator = document.getElementById(`owner-${cellIdx}`);
    if(indicator) indicator.style.background = player.color;

    const badgeContainer = document.getElementById(`badge-${cellIdx}`);
    if(badgeContainer) {
      badgeContainer.innerHTML = `
        <div class="owner-badge-tile">
          <span class="owner-badge-dot" style="background:${player.color}"></span>
          <span>${player.name.substring(0,6)}</span>
        </div>
      `;
    }

    const ownerLbl = document.getElementById(`history-owner-lbl-${cellIdx}`);
    if(ownerLbl) {
      ownerLbl.textContent = player.name.toUpperCase();
      ownerLbl.style.background = player.color;
      ownerLbl.style.color = "#1C0A04";
    }

    logMsg(`🚩 <b>${player.name}</b> claimed <b>${tileTitle}</b> for <b>₹${tile.price}</b>.`);
    showTransactionPopup(player, `₹${tile.price}`, false, `Territory Claim: ${tile.city}`);
    updateHUD();

    triggerConquestAnimation(player, tileTitle);
  }

  function buildHouse(player, cellIdx) {
    const tile = BOARD_TILES[cellIdx];
    const tileTitle = `${tile.city} - ${tile.monument}`;
    const bState = gameState.boardState[cellIdx];
    
    player.paise -= tile.housePaisePrice;
    bState.houses++;

    const buildBar = document.getElementById(`build-${cellIdx}`);
    if(buildBar) {
      if(bState.houses === 5) {
        buildBar.innerHTML = `<div class="hotel-icon"></div>`;
      } else {
        buildBar.innerHTML += `<div class="house-icon"></div>`;
      }
    }

    logMsg(`🏰 <b>${player.name}</b> constructed a ${bState.houses === 5 ? 'Royal Palace' : 'Haveli'} on <b>${tileTitle}</b>.`);
    showTransactionPopup(player, `${tile.housePaisePrice} Paise`, false, `Construction on ${tile.city}`);
    updateHUD();
    nextTurn();
  }

  function payRupees(fromPlayer, toPlayer, amount, reason = "Tax Payment") {
    showTransactionPopup(fromPlayer, `₹${amount}`, false, reason);
    if(toPlayer) {
      showTransactionPopup(toPlayer, `₹${amount}`, true, reason);
    }

    if(fromPlayer.rupees >= amount) {
      fromPlayer.rupees -= amount;
      if(toPlayer) toPlayer.rupees += amount;
    } else {
      logMsg(`💀 <b>${fromPlayer.name}</b> went BANKRUPT!`);
      fromPlayer.bankrupt = true;
      if(toPlayer) toPlayer.rupees += fromPlayer.rupees;
      fromPlayer.rupees = 0;
      fromPlayer.paise = 0;
      
      gameState.boardState.forEach((b, idx) => {
        if(b.owner === fromPlayer.id) {
          b.owner = null;
          b.houses = 0;
          const cellEl = document.getElementById(`cell-${idx}`);
          if(cellEl) cellEl.classList.remove("owned");
          const ind = document.getElementById(`owner-${idx}`);
          if(ind) ind.style.background = "transparent";
          const build = document.getElementById(`build-${idx}`);
          if(build) build.innerHTML = "";
          const badgeContainer = document.getElementById(`badge-${idx}`);
          if(badgeContainer) badgeContainer.innerHTML = "";
        }
      });
    }
    updateHUD();
    checkWinCondition();
  }

  function checkWinCondition() {
    const active = gameState.players.filter(p => !p.bankrupt);
    if(active.length === 1) {
      showModal("EMPIRE CONQUERED", "#D4AF37", "VIRASATX VICTORY", "Ultimate Sovereign", `👑 <b>${active[0].name}</b> has united the kingdoms and reigns supreme!`, [
        { label: "New Campaign", callback: () => location.reload() }
      ]);
    }
  }

  function nextTurn() {
    gameState.isRolling = false;
    rollBtn.disabled = false;
    
    do {
      gameState.currentPlayer = (gameState.currentPlayer + 1) % gameState.players.length;
    } while(gameState.players[gameState.currentPlayer].bankrupt && gameState.players.filter(p=>!p.bankrupt).length > 1);

    updateHUD();
  }

  rollBtn.addEventListener("click", handleTurn);

  window.addEventListener("resize", () => {
    updateTokenPositions();
  });

  setTimeout(() => {
    updateTokenPositions();
    updateBillboardRotations(-10);
    updateHUD();
    logMsg("👑 The Realm Awakens! <b>Suryavanshi</b>'s turn.");
  }, 150);
</script>

</body>
</html>
